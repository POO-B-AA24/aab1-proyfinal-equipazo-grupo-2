								{
									"_type": "UMLOperation",
									"_id": "AAAAAAGQ5SmYaCGKTjM=",
									"_parent": {
										"$ref": "AAAAAAGQ5SmYaCF7/B0="
									},
									"name": "updateFactura",
									"documentation": "public static int getNextFacturaId() {\r\n        String sql = \"SELECT MAX(id) AS last_id FROM Facturas\";\r\n        try (ResultSet resultSet = ConexionADataBase.executeQuery(sql)) {\r\n            if (resultSet.next()) {\r\n                int lastId = resultSet.getInt(\"last_id\");\r\n                return lastId + 1;\r\n            }\r\n        } catch (SQLException e) {\r\n            System.err.println(\"Error retrieving data from the database: \" + e.getMessage());\r\n        }\r\n        return 1; // Return 1 if the table is empty\r\n    }",
									"isStatic": true,
									"parameters": [
										{
											"_type": "UMLParameter",
